<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- consoleAllocationPolicy=detached in the spelling Microsoft's application manifest
     reference documents: asmv3:windowsSettings in the 2024 WindowsSettings namespace.
     Embedded into pitboard-probe-detached by build.rs, for block E4. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <asmv3:application>
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">
      <consoleAllocationPolicy>detached</consoleAllocationPolicy>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
