/build/
# Generated by `xcodegen generate` from project.yml. Only the package pins are kept: the
# build checks Sparkle against them, and the app's bill of materials reads them.
/Pitboard.xcodeproj/*
!/Pitboard.xcodeproj/project.xcworkspace/
/Pitboard.xcodeproj/project.xcworkspace/*
!/Pitboard.xcodeproj/project.xcworkspace/xcshareddata/
/Pitboard.xcodeproj/project.xcworkspace/xcshareddata/*
!/Pitboard.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
/Pitboard.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Pitboard.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/PitboardFFI.xcframework
/Sources/PitboardBindings/
/.build/
# What Xcode keeps for whoever has the project open: window state, breakpoints, and the
# package it opens beside the project.
xcuserdata/
/.swiftpm/
